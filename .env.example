# База данных PostgreSQL
DATABASE_URL=postgresql://auteko_user:your_password@localhost:5432/auteko_db

# JWT секрет для авторизации (сгенерируй: openssl rand -base64 32)
# Минимум 32 символа. Приложение не стартует со слабым или примерным значением.
JWT_SECRET=your_super_secret_key_here

# URL сайта (в проде https://..., иначе cookie с Secure не работает; используется для проверки Origin)
NEXT_PUBLIC_APP_URL=http://localhost:3000
